                "tags": [
                    "Entreprises"
                ],
                "summary": "Créer une entreprise",
                "operationId": "b9931edbf7734e3005034bc1f8c4d938",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "nom",
                                    "ville"
                                ],
                                "properties": {
                                    "nom": {
                                        "type": "string",
                                        "example": "BigBen Connected"
                                    },
                                    "secteur": {
                                        "type": "string",
                                        "example": "Technologie"
                                    },
                                    "adresse": {
                                        "type": "string",
                                        "example": "123 Rue de Paris"
                                    },
                                    "ville": {
                                        "type": "string",
                                        "example": "Fontainebleau"
                                    },
                                    "site_web": {
                                        "type": "string",
                                        "example": "https://www.bigben.com"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Entreprise créée avec succès"
                    },
                    "422": {
                        "description": "Erreur de validation"
                    }
                }
            }
        },
